NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5174
# Co the them origin LAN, phan tach bang dau phay. Chi chap nhan origin chinh xac.
# Production cung domain co the bo CLIENT_ORIGIN: PUBLIC_APP_URL luon duoc cho phep.
# Dia chi frontend duoc ghi vao QR; dung IP LAN khi demo bang dien thoai.
PUBLIC_APP_URL=http://localhost:5174
# MongoDB cuc bo cho phat trien, khong chua mat khau that.
MONGODB_URI=mongodb://127.0.0.1:27017/restaurant_qr
# Tao chuoi ngau nhien rieng trong .env, khong commit secret that.
JWT_SECRET=
# Khoa rieng de khoi phuc ma xem don khi retry; giu on dinh, khong dung chung JWT_SECRET.
ORDER_TOKEN_SECRET=

# 0 khi Node duoc truy cap truc tiep. Hosting qua proxy: so hop proxy dang tin cay.
TRUST_PROXY=0

# Chi dung cho database demo rieng; reset doi chieu ten ket noi that, can --confirm.
DEMO_DB_NAME=restaurant_qr_demo
# It nhat 10 ky tu, toi da 72 byte UTF-8. Khong hardcode mat khau trong source.
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=

# Chi dung cho npm run create:user, khong phai API dang ky.
# Sau khi tao tai khoan, co the xoa CREATE_USER_PASSWORD khoi .env.
CREATE_USER_ROLE=admin
CREATE_USER_FULL_NAME="Quan ly"
CREATE_USER_USERNAME=admin
CREATE_USER_PASSWORD=
